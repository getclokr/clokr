    },
    "team.heute.fehlende-zeiten": { "kind": "widget" },
    "team.heute.aufgaben": {
      "kind": "widget",
      "filters": [
        "alle",
        "urlaub",
        "nachtrag",
        "paragraf9",
        "pausenbefund",
        "ausstempeln",
        "zeitkorrektur"
      ],
      "defaultFilter": "alle"
    },
    "team.heute.demnaechst": { "kind": "widget", "defaultFilter": "alle" },
    "team.heute.team-woche": { "kind": "table" },
    "ich.tag.fuer-dich": { "kind": "widget" },
    "ich.tag.letzte-tage": { "kind": "widget" },
    "ich.tag.verlauf": { "kind": "widget" },
    "verwalten.monatsabschluss.verschoben": { "kind": "widget" },
    "team.aufgaben.liste": { "kind": "table" },
